FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mock-api ./cmd/mock-api

FROM alpine:3.22
RUN addgroup -S mock && adduser -S -G mock mock
USER mock
COPY --from=build /out/mock-api /usr/local/bin/mock-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mock-api"]

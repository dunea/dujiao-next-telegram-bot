# Dujiao-Next channel API
DUJIAO_BASE_URL=https://shop.example.com
DUJIAO_CHANNEL_KEY=
DUJIAO_CHANNEL_SECRET=

# Optional: when empty, the bot token is pulled from the Dujiao channel config.
TELEGRAM_BOT_TOKEN=

# Optional, only for a self-hosted Telegram Bot API or local integration tests.
TELEGRAM_API_URL=

# Runtime
BOT_DEFAULT_LOCALE=zh-CN
BOT_POLL_TIMEOUT=30s
BOT_HTTP_LISTEN=:8444
BOT_SHUTDOWN_TIMEOUT=10s
BOT_LOG_LEVEL=info

# Optional durable sessions. Empty URL uses memory (no protection across restart).
# With compose.redis.yml the Redis URL is supplied automatically.
BOT_REDIS_URL=
# Generate ONCE with: openssl rand -hex 32
# Keep this key stable and backed up. Never reuse the public demo/test key.
BOT_SESSION_ENCRYPTION_KEY=

# Optional private admin Telegram user IDs, comma-separated, max 10.
# Send /whoami in private chat to get your ID, configure it here, then /admin to test.
BOT_ADMIN_USER_IDS=
# Optional local audit JSONL sink; Docker Compose supplies its persistent path.
# Active file: 10 MiB; 5 rotated backups. Parent directory must exist and be writable.
BOT_AUDIT_FILE=

# Positive values only (1..100000). GCRA bursts refill gradually.
BOT_RATE_USER_PER_MINUTE=60
BOT_RATE_WRITE_PER_MINUTE=10
BOT_RATE_WITHDRAWAL_PER_10_MINUTES=3
BOT_RATE_CALLBACK_PER_MINUTE=120
# Per TCP peer for callback HTTP; global ingress budget is twice this value.
BOT_RATE_HTTP_PER_MINUTE=3000
BOT_RATE_GLOBAL_PER_MINUTE=3000
